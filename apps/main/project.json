{
  "name": "main",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "generators": {
    "@schematics/angular:component": {
      "inlineTemplate": true,
      "skipTests": true
    },
    "@schematics/angular:class": {
      "skipTests": true
    },
    "@schematics/angular:directive": {
      "skipTests": true
    },
    "@schematics/angular:guard": {
      "skipTests": true
    },
    "@schematics/angular:interceptor": {
      "skipTests": true
    },
    "@schematics/angular:pipe": {
      "skipTests": true
    },
    "@schematics/angular:resolver": {
      "skipTests": true
    },
    "@schematics/angular:service": {
      "skipTests": true
    }
  },
  "sourceRoot": "apps/main/src",
  "prefix": "app",
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "options": {
        "outputPath": "dist/apps/main",
        "browser": "apps/main/src/main.ts",
        "tsConfig": "apps/main/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/main/public"
          },
          "apps/main/src/assets"
        ],
        "styles": [
          "./node_modules/normalize.css/normalize.css",
          "apps/main/src/styles.css"
        ],
        "server": "apps/main/src/main.server.ts",
        "statsJson": true,
        "outputMode": "server",
        "security": {
          "allowedHosts": []
        },
        "ssr": {
          "entry": "apps/main/src/server.ts"
        }
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kB",
              "maximumError": "1MB"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kB",
              "maximumError": "8kB"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "dependsOn": [
        "api:serve"
      ],
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "proxyConfig": "apps/main/proxy.conf.js"
      },
      "configurations": {
        "production": {
          "buildTarget": "main:build:production"
        },
        "development": {
          "buildTarget": "main:build:development"
        }
      }
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "main:build"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "main:build",
        "port": 4201,
        "staticFilePath": "dist/apps/main/browser",
        "spa": true
      }
    },
    "lint": {
      "executor": "@angular-eslint/builder:lint",
      "options": {
        "lintFilePatterns": [
          "apps/main/**/*.ts",
          "apps/main/**/*.html"
        ],
        "eslintConfig": "apps/main/eslint.config.mjs"
      }
    }
  }
}
