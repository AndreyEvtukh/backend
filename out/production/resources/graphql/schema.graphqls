type Query {
    me: UserDTO
    emailExists(email: String!): AuthPayload!
}

type Mutation {
    login(input: LoginInput!): AuthPayload!

    register(input: RegisterInput!): AuthPayload!

    verify(input: VerifyInput!): AuthPayload!

    logout: AuthPayload!

    resetPassword(input: ResetPasswordInput!): AuthPayload!

    sendEmail(input: SendEmailInput!): AuthPayload!
}

type UserDTO {
    id: String!
    username: String!
    email: String!
    role: String!
}

input RegisterInput {
    username: String!
    email: String!
    password: String!
}

input VerifyInput {
    email: String!
    code: String!
}

input LoginInput {
    email: String!
    password: String!
}

input ResetPasswordInput {
    email: String!
    password: String!
}

input SendEmailInput {
    email: String!
    userName: String!
    message: String!
}

type AuthPayload {
    id: String
    token: String
    username: String
    role: String
    email: String
    message: String
    expiresAt: String
    exists: Boolean
    success: Boolean
}